<!doctype html><html lang="vi"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>BÁ CHỦ VÙNG BIỂN</title>
<style>
*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Arial,sans-serif;color:#fff;background:#03263d}body{overflow-x:hidden}
.app{min-height:100vh;background:linear-gradient(#075b82,#08799a 48%,#02364f)}
.header{text-align:center;padding:14px 8px 8px}.header h1{margin:0;font-size:clamp(28px,7vw,46px);text-shadow:0 3px 4px #002638}.header p{margin:5px 0;opacity:.9}
.panel{width:min(1100px,96%);margin:auto;background:#00182abd;border:1px solid #ffffff33;border-radius:18px;padding:12px;box-shadow:0 10px 30px #0005}
.controls{display:grid;grid-template-columns:1fr auto auto auto;gap:8px}textarea{width:100%;min-height:58px;border:0;border-radius:12px;padding:10px;resize:vertical}
button{border:0;border-radius:11px;padding:10px 13px;font-weight:bold}.primary{background:#ffd84d;color:#12354a}.blue{background:#55d8ff;color:#00334a}.dark{background:#174d68;color:#fff}
.settings{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;align-items:center}.settings label{background:#ffffff12;padding:7px 9px;border-radius:9px}.settings input{width:75px;border:0;border-radius:7px;padding:6px}
.info{font-size:12px;opacity:.8;margin:8px 2px}
#race{position:relative;overflow:hidden;margin-top:10px;border:3px solid #ffffff33;border-radius:17px;background:linear-gradient(#087fa7,#056681,#03445e);height:clamp(380px,65vh,700px);min-height:380px}
#track{position:absolute;inset:0;z-index:2}
.racer{position:absolute;left:0;transform:translateY(-50%);height:52px;z-index:4}
.racer .creature{position:relative;left:0;top:0}
.creature{width:54px;height:48px;display:flex;align-items:center;justify-content:center;font-size:34px;will-change:left;filter:drop-shadow(0 3px 2px #0008)}
.creature b{position:absolute;left:51px;white-space:nowrap;font-size:11px;background:#002536cc;border-radius:7px;padding:3px 6px}
.finish{position:absolute;right:10px;top:0;bottom:0;width:9px;z-index:8;background:repeating-linear-gradient(0deg,#fff 0 8px,#17364a 8px 16px)}
.start{position:absolute;left:5px;top:0;bottom:0;width:3px;background:#fff8;z-index:8}
.bubble{position:absolute;border:2px solid #ffffff55;border-radius:50%;animation:rise 8s linear infinite;z-index:1}
@keyframes rise{from{transform:translateY(30px);opacity:0}30%{opacity:.7}to{transform:translateY(-500px);opacity:0}}
.status{display:flex;justify-content:space-between;align-items:center;margin-top:9px;gap:8px}
#message{font-weight:bold}
#timer{font-size:25px;font-weight:900;color:#ffe45b;min-width:85px;text-align:center}
.results{display:none;margin-top:9px;background:#001b2dcc;border-radius:13px;padding:10px}
.results h2{margin:0 0 7px;font-size:18px}
.row{display:flex;gap:9px;align-items:center;padding:5px;border-bottom:1px solid #ffffff18}
.footer{text-align:center;font-size:11px;opacity:.6;padding:12px}

@media(min-width:901px){
#race{height:min(70vh,700px)}
.creature{font-size:38px}
}
@media(max-width:900px){
.controls{grid-template-columns:1fr 1fr}
.controls textarea{grid-column:1/-1}
}
@media(max-width:600px){
.panel{width:98%;padding:9px}
#race{height:58vh;min-height:350px}
.creature{font-size:29px}
.creature b{font-size:9px}
button,input,textarea{font-size:15px}
}

/* Polished ocean arena */
#race{
background:radial-gradient(circle at 50% 8%,#2cc8e7 0,#0a87aa 34%,#045d7d 68%,#023b59 100%);
box-shadow:inset 0 0 70px #001d2b88,0 12px 35px #001b2c88
}
.sky-glow{
position:absolute;
inset:-20%;
background:radial-gradient(circle at 50% 0,#ffffff2e,transparent 38%);
pointer-events:none;
z-index:0
}
.depth{
position:absolute;
left:0;
right:0;
border-radius:50%;
pointer-events:none;
filter:blur(1px);
opacity:.2;
z-index:1
}
.depth1{height:90px;bottom:-30px;background:#001d31}
.depth2{height:55px;bottom:42px;background:#003b50}
.reef,.rock,.scenery-fish{
position:absolute;
pointer-events:none;
user-select:none;
z-index:1;
filter:blur(.8px);
opacity:.58
}
.reef{font-size:55px;bottom:3px}
.reef-a{left:2%}
.reef-b{right:3%;font-size:65px}
.reef-c{left:47%;bottom:-4px;font-size:45px}
.rock{font-size:48px;bottom:8px;opacity:.38}
.rock-a{left:17%}
.rock-b{right:18%;font-size:55px}
.rock-c{left:70%;bottom:25px;font-size:38px}
.scenery-fish{
font-size:35px;
opacity:.16;
filter:blur(1.8px);
animation:swim 12s linear infinite
}
.sf1{top:18%;left:8%}
.sf2{top:35%;right:12%;animation-delay:-4s}
.sf3{top:62%;left:28%;animation-delay:-8s}
@keyframes swim{
0%{transform:translateX(-20px)}
50%{transform:translateX(80px)}
100%{transform:translateX(-20px)}
}
#bubbles{
position:absolute;
inset:0;
z-index:1;
pointer-events:none
}
</style>
</head>

<body>
<div class="app">

<header class="header">
<h1>🌊 BÁ CHỦ VÙNG BIỂN 🐋</h1>
<p>Ai sẽ thống trị đại dương?</p>
</header>

<main class="panel">

<div class="controls">
<textarea id="names">An
Bình
Chi
Dũng
Hà
Lan</textarea>

<button class="blue" id="create">🐚 Tạo đường đua</button>
<button class="dark" id="shuffle">🔀 Đổi sinh vật</button>
<button class="primary" id="start">🚀 Bắt đầu</button>
</div>

<div class="settings">
<label>
⏱ Thời gian
<input id="duration" type="number" min="1" max="600" value="60">
giây
</label>

<button class="dark" id="reset">↻ Chơi lại</button>
</div>

<div class="info">
Mỗi dòng là <b>1 tay đua</b>.
Nhập bao nhiêu tên thì tạo đúng bấy nhiêu cá.
Tất cả cá cùng đua trong <b>một đường biển chung</b>,
không chia thành ô/làn riêng.
Hỗ trợ PC và điện thoại.
</div>

<section id="race">

<div class="sky-glow"></div>

<div class="reef reef-a">🪸</div>
<div class="reef reef-b">🪸</div>
<div class="reef reef-c">🌿</div>

<div class="rock rock-a">🪨</div>
<div class="rock rock-b">🪨</div>
<div class="rock rock-c">🪨</div>

<div class="scenery-fish sf1">🐟</div>
<div class="scenery-fish sf2">🐠</div>
<div class="scenery-fish sf3">🐟</div>

<div id="bubbles"></div>
<div id="track"></div>

<div class="finish"></div>
<div class="start"></div>

<div class="depth depth1"></div>
<div class="depth depth2"></div>

</section>

<div class="status">
<div id="message">Sẵn sàng!</div>
<div id="timer">60.0s</div>
</div>

<div class="results" id="results"></div>

</main>

<div class="footer">
BÁ CHỦ VÙNG BIỂN • Ocean Race
</div>

</div>

<script>

const seaCreatures=[

["Cá hề","🐠"],
["Cá ngựa","🐠"],
["Cá mập","🦈"],
["Cá voi","🐋"],
["Cá heo","🐬"],
["Bạch tuộc","🐙"],
["Mực ống","🦑"],
["Sứa","🪼"],
["Cua","🦀"],
["Tôm","🦐"],
["Rùa biển","🐢"],
["Hải cẩu","🦭"],
["Lươn biển","🐍"],
["Cá đuối","🐟"],
["Cá nóc","🐡"],
["Cá kiếm","🐟"],
["Cá ngừ","🐟"],
["Cá thu","🐟"],
["Cá mòi","🐟"],
["Cá trích","🐟"],
["Cá cơm","🐟"],
["Cá tuyết","🐟"],
["Cá chim","🐟"],
["Cá mú","🐟"],
["Cá bơn","🐟"],
["Cá bướm","🐠"],
["Cá thiên thần","🐠"],
["Cá đuôi gai","🐠"],
["Cá mao tiên","🐠"],
["Cá rồng biển","🐟"],
["Cá mặt trăng","🐟"],
["Cá nhồng","🐟"],
["Cá barracuda","🐟"],
["Cá măng","🐟"],
["Cá tráp","🐟"],
["Cá dìa","🐟"],
["Cá đối","🐟"],
["Cá hồng","🐟"],
["Cá cam","🐟"],
["Cá mập voi","🦈"],
["Cá mập đầu búa","🦈"],
["Cá mập trắng","🦈"],
["Cá mập hổ","🦈"],
["Cá mập mako","🦈"],
["Cá đuối manta","🐟"],
["Cá đuối điện","🐟"],
["Lươn moray","🐍"],
["Cá chìa vôi","🐟"],
["Cá kèn","🐟"],
["Cá bác sĩ xanh","🐟"],
["Cá bác sĩ vàng","🐟"],
["Cá tang xanh","🐟"],
["Cá tang vàng","🐟"],
["Cá đuôi kiếm","🐟"],
["Cá bống","🐟"],
["Cá thia","🐟"],
["Cá thia xanh","🐟"],
["Cá thia vàng","🐟"],
["Cá thia đỏ","🐟"],
["Cá mú đỏ","🐟"],
["Cá mú xanh","🐟"],
["Cá mú vàng","🐟"],
["Cá hồng đỏ","🐟"],
["Cá hồng cam","🐟"],
["Cá koi đỏ","🐟"],
["Cá koi trắng","🐟"],
["Cá koi vàng","🐟"],
["Cá koi đen","🐟"],
["Cá koi cam","🐟"],
["Cá koi xanh","🐟"],
["Cá koi đỏ-trắng","🐟"],
["Cá koi vàng-trắng","🐟"],
["Cá koi tam sắc","🐟"],
["Tôm hùm","🦞"],
["Tôm càng","🦐"],
["Mực nang","🦑"],
["Mực khổng lồ","🦑"],
["Bạch tuộc vòng xanh","🐙"],
["Cá voi sát thủ","🐋"],
["Cá voi xanh","🐋"],
["Cá nhà táng","🐋"],
["Cá voi lưng gù","🐋"],
["Cá voi beluga","🐋"],
["Chim cánh cụt","🐧"]

];

let racers=[];
let running=false;
let raf=0;
let startTime=0;
let durationMs=60000;

const $=id=>document.getElementById(id);

const track=$("track");
const namesBox=$("names");
const durationBox=$("duration");
const message=$("message");
const timer=$("timer");
const results=$("results");

function cleanNames(){
return namesBox.value
.split(/\r?\n/)
.map(v=>v.trim())
.filter(Boolean);
}

function shuffle(a){
for(let i=a.length-1;i>0;i--){
const j=Math.floor(Math.random()*(i+1));
[a[i],a[j]]=[a[j],a[i]];
}
return a;
}

function makeBubbles(){

const b=$("bubbles");
b.innerHTML="";

for(let i=0;i<22;i++){

const x=document.createElement("i");

x.className="bubble";

const size=5+Math.random()*14;

x.style.width=size+"px";
x.style.height=size+"px";
x.style.left=(Math.random()*100)+"%";
x.style.bottom=(-20-Math.random()*120)+"px";
x.style.animationDelay=(-Math.random()*8)+"s";
x.style.animationDuration=(5+Math.random()*7)+"s";

b.appendChild(x);

}

}

function makeRace(){

cancelAnimationFrame(raf);

running=false;

const names=cleanNames();

if(!names.length){

track.innerHTML="";
message.textContent="Hãy nhập ít nhất 1 tên.";

return;

}

const pool=shuffle([...seaCreatures]);

racers=names.map((name,i)=>({

name,
species:pool[i%pool.length],
progress:0,
speed:.72+Math.random()*.55,
el:null

}));

track.innerHTML="";

racers.forEach((r,i)=>{

const wrap=document.createElement("div");

wrap.className="racer";

wrap.style.top=(6+(i+.5)*(88/racers.length))+"%";

const c=document.createElement("div");

c.className="creature";

c.innerHTML="<span></span><b></b>";

c.querySelector("span").textContent=r.species[1];
c.querySelector("b").textContent=r.name;

wrap.appendChild(c);

track.appendChild(wrap);

r.el=c;

});

durationMs=
Math.max(
1,
Math.min(
600,
Number(durationBox.value)||60
)
)*1000;

timer.textContent=
(durationMs/1000).toFixed(1)+"s";

message.textContent=
`${racers.length} tay đua — cùng chung một đường đua!`;

results.style.display="none";
results.innerHTML="";

makeBubbles();
positionRacers();

}

function positionRacers(){

const width=track.clientWidth;

racers.forEach(r=>{

if(!r.el)return;

const maxX=
Math.max(
0,
width-r.el.offsetWidth-18
);

r.el.parentElement.style.left=
(6+r.progress*maxX)+"px";

});

}

function start(){

if(running)return;

if(!racers.length)makeRace();

if(!racers.length)return;

durationMs=
Math.max(
1,
Math.min(
600,
Number(durationBox.value)||60
)
)*1000;

startTime=performance.now();

running=true;

message.textContent="🏁 Đang đua!";

raf=requestAnimationFrame(loop);

}

function loop(now){

if(!running)return;

const elapsed=now-startTime;

const ratio=
Math.min(
1,
elapsed/durationMs
);

timer.textContent=
Math.max(
0,
(durationMs-elapsed)/1000
).toFixed(1)+"s";

racers.forEach((r,i)=>{

const base=
ratio*(.80+r.speed*.16);

const wobble=
Math.sin(
elapsed/650+i*1.31
)*.014*ratio;

r.progress=
Math.min(
.985,
Math.max(
0,
base+wobble
)
);

});

positionRacers();

if(elapsed>=durationMs){

finish();

return;

}

raf=requestAnimationFrame(loop);

}

function finish(){

running=false;

cancelAnimationFrame(raf);

racers.sort(
(a,b)=>b.progress-a.progress
);

timer.textContent="0.0s";

message.textContent=
`🏆 BÁ CHỦ VÙNG BIỂN: ${racers[0].name}`;

results.style.display="block";

results.innerHTML=
"<h2>🏆 Kết quả</h2>"+
racers.map((r,i)=>

`<div class="row">
<strong>${i+1}.</strong>
<span>${r.species[1]}</span>
<b>${r.name}</b>
<span style="margin-left:auto">
${(r.progress*100).toFixed(1)}%
</span>
</div>`

).join("");

positionRacers();

}

$("create").onclick=makeRace;

$("start").onclick=start;

$("reset").onclick=makeRace;

$("shuffle").onclick=()=>{

if(!racers.length){

makeRace();

return;

}

racers.forEach(r=>{

r.species=
seaCreatures[
Math.floor(
Math.random()*seaCreatures.length
)
];

r.el
.querySelector("span")
.textContent=r.species[1];

});

};

durationBox.onchange=()=>{

durationMs=
Math.max(
1,
Math.min(
600,
Number(durationBox.value)||60
)
)*1000;

if(!running){

timer.textContent=
(durationMs/1000).toFixed(1)+"s";

}

};

window.addEventListener(
"resize",
positionRacers
);

makeRace();

</script>

</body>
</html>
